{
  "name": "rescuecodec-dashboard",
  "private": true,
  "version": "2.0.0",
  "description": "Command-post dashboard for the RescueCodec gateway. Uses only the public API in spec/api/openapi.yaml.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock": "node mock/server.mjs",
    "build": "tsc --noEmit && node scripts/prebuild.mjs && vite build && node scripts/copy-map.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@protomaps/basemaps": "^5.7.2",
    "lucide-react": "^1.79.0",
    "maplibre-gl": "^6.19.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "ws": "^8.23.0",
    "yaml": "^2.9.1"
  }
}
