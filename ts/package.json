{
  "name": "@rescuecodec/core",
  "version": "2.0.0",
  "description": "RescueCodec v2: tiny protobuf messages for rescue teams on LoRa mesh. Encode, decode, readable text (de/en).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "gen": "sh scripts/gen.sh",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.2.5"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.2.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
